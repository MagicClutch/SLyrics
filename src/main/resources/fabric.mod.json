{
	"schemaVersion": 1,
	"id": "slyrics",
	"version": "${version}",
	"name": "SLyrics",
	"description": "Shows the lyrics of the song currently playing on Spotify as floating text in the world.",
	"authors": ["SLyrics"],
	"license": "MIT",
	"icon": "assets/slyrics/icon.png",
	"environment": "client",
	"mixins": ["slyrics.mixins.json"],
	"entrypoints": {
		"client": ["dev.slyrics.SLyricsClient"]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": ">=26.3",
		"java": ">=25",
		"fabric-api": "*",
		"resourcefulconfig": ">=5.0.0"
	}
}
